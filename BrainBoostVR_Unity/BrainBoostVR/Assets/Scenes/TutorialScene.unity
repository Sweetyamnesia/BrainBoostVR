  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2a7c7c2180b04493cbaa9f05ae74ce5f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  steps:
  - text: "Bienvenue dans le tutoriel. Vous allez apprendre les bases avant de commencer
      l\u2019exp\xE9rience."
    audio: {fileID: 8300000, guid: a8728ccd5a1b54c40b4124f0ab944a91, type: 3}
    targetZone: {fileID: 667599385}
  - text: "D\xE9placez-vous jusqu\u2019\xE0 la zone verte en utilisant le joystick
      gauche ou la t\xE9l\xE9portation."
    audio: {fileID: 8300000, guid: 0677808f086d04d9eb562b9fe6979587, type: 3}
    targetZone: {fileID: 972230095}
  - text: "Attrapez l\u2019objet devant vous avec la g\xE2chette du contr\xF4leur
      droit."
    audio: {fileID: 8300000, guid: bf899240399054f598519b4abb7a968c, type: 3}
    targetZone: {fileID: 2088054070}
  - text: "Rel\xE2chez l\u2019objet dans la zone rouge pour valider."
    audio: {fileID: 8300000, guid: 02e8b654f16d541c08fa1ec0f9bc2ddb, type: 3}
    targetZone: {fileID: 1082856000}
  - text: "Bravo, vous ma\xEEtrisez les bases. Le tutoriel est termin\xE9."
    audio: {fileID: 8300000, guid: 8691e6216f0394bc2b99ca28e4f69507, type: 3}
    targetZone: {fileID: 1692173657}
  subtitleText: {fileID: 1401921616}
  audioSource: {fileID: 56282516}
